# VeriFit — root environment documentation
# Copy to .env.local and fill in real values for local development.
# .env.local is git-ignored by the root .gitignore.

# ── API (apps/api) ────────────────────────────────────────────────────────────
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
NODE_ENV=development

# ── Database (packages/database + apps/api) ───────────────────────────────────
# Prisma reads DATABASE_URL directly from the environment.
DATABASE_URL=postgresql://verifit:verifit@localhost:5432/verifit

# ── Worker (apps/worker) ──────────────────────────────────────────────────────
# Use WORKER_PORT and API_PORT to avoid collisions when both processes share an environment.
WORKER_PORT=3002
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LOG_LEVEL=info

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_ISSUER=verifit-api
JWT_AUDIENCE=verifit-web
# Google OAuth — optional; API boots without these. Set to enable OAuth flow.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback
