{
  "name": "@verifit/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env.local -- prisma migrate dev",
    "db:seed": "tsx --env-file=../../.env.local prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env.local -- prisma studio",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
