{
  "name": "@verifit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VeriFit Background Job Processor",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "^6.0.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
